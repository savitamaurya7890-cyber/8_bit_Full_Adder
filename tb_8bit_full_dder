module tb_fa_8bit;

// Inputs
reg [7:0] a;
reg [7:0] b;

// Outputs
wire [7:0] sum;
wire carry_out;

// Instantiate DUT (Direct fa_8bit)
fa_8bit uut (
    .a(a),
    .b(b),
    .sum(sum),
    .carry_out(carry_out)
);

initial
begin
    // Initialize inputs
    a = 8'b00000000; b = 8'b00000000;
    #10;

    // Test Case 1: 3 + 2 = 5
    a = 8'b00000011; b = 8'b00000010;
    #10;

    // Test Case 2: 5 + 3 = 8
    a = 8'b00000101; b = 8'b00000011;
    #10;

    // Test Case 3: 15 + 1 = 16
    a = 8'b00001111; b = 8'b00000001;
    #10;

    // Test Case 4: Overflow case
    a = 8'b11111111; b = 8'b00000001;
    #10;

    // Test Case 5: Pattern test
    a = 8'b10101010; b = 8'b01010101;
    #10;

    // Test Case 6: Pattern test
    a = 8'b11001100; b = 8'b00110011;
    #10;

    // Finish simulation
    $finish;
end

// Monitor output
initial
begin
    $monitor("Time=%0t | a=%b b=%b | sum=%b carry=%b",
              $time, a, b, sum, carry_out);
end

endmodule
